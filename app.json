{
  "expo": {
    "name": "eerme",
    "slug": "eerme",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eerme",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eerme.app",
      "buildNumber": "18",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "앱이 프로필 사진 설정을 위해 카메라에 접근합니다.",
        "NSPhotoLibraryUsageDescription": "앱이 일기와 프로필에 사진을 첨부하기 위해 사진 라이브러리에 접근합니다.",
        "NSPhotoLibraryAddUsageDescription": "앱이 사진을 저장하기 위해 사진 라이브러리에 접근합니다."
      },
      "privacyManifests": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.eerme.app",
      "allowBackup": true,
      "versionCode": 18
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow eerme to access your photo library so you can attach photos to your journal entries and profile, for example selecting a meal or progress photo from your library."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "58323cc1-bf17-40c7-baaa-f95cda402f31"
      },
      "revenueCat": {
        "apiKey": "appl_IoDXnLEFpuZoFEQqVkfZFSeRDgO"
      }
    },
    "owner": "gamjabaht"
  }
}
